FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo pdo_sqlite sqlite3

WORKDIR /app


# =========================
# PHP DEPENDENCIES
# =========================

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .

# Buat .env dengan nilai yang benar untuk production (tanpa database server)
RUN cp .env.example .env \
    && sed -i 's|^APP_KEY=.*|APP_KEY=base64:nlIg5aPSIFYC+Fv8dDh1qsXNtyZK+goLYYf/16TChrQ=|' .env \
    && sed -i 's|^APP_ENV=.*|APP_ENV=production|' .env \
    && sed -i 's|^APP_URL=.*|APP_URL=https://my-porto-jade-ten.vercel.app|' .env \
    && sed -i 's|^APP_DEBUG=.*|APP_DEBUG=true|' .env \
    && sed -i 's|^SESSION_DRIVER=.*|SESSION_DRIVER=array|' .env \
    && sed -i 's|^CACHE_STORE=.*|CACHE_STORE=array|' .env \
    && sed -i 's|^QUEUE_CONNECTION=.*|QUEUE_CONNECTION=sync|' .env \
    && sed -i 's|^LOG_CHANNEL=.*|LOG_CHANNEL=stderr|' .env

# Buat direktori yang dibutuhkan & database sqlite kosong
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
        database \
    && touch database/database.sqlite

# Optimize autoloader
RUN composer dump-autoload \
    --no-dev \
    --classmap-authoritative

# Cache config, routes, dan views saat build (lebih cepat di production)
RUN php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache


# =========================
# FRONTEND BUILD
# =========================

FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY vite.config.js ./
COPY public ./public

RUN npm run build


# =========================
# RUNTIME
# =========================

FROM base AS runtime

COPY --from=dependencies \
    --chown=www-data:www-data \
    /app /app

COPY --from=frontend \
    --chown=www-data:www-data \
    /app/public/build /app/public/build

COPY --chown=www-data:www-data \
    Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy \
    && chmod -R 775 /app/storage /app/bootstrap/cache

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]