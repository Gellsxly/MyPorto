FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo pdo_sqlite sqlite3

WORKDIR /app


# =========================
# PHP DEPENDENCIES
# =========================

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .

# Generate .env dari .env.example, buat direktori yang dibutuhkan,
# buat database SQLite, lalu optimize autoloader
RUN cp .env.example .env \
    && mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
        database \
    && touch database/database.sqlite \
    && composer dump-autoload \
        --no-dev \
        --classmap-authoritative


# =========================
# FRONTEND BUILD
# =========================

FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY vite.config.js ./
COPY public ./public

RUN npm run build


# =========================
# RUNTIME
# =========================

FROM base AS runtime

COPY --from=dependencies \
    --chown=www-data:www-data \
    /app /app

COPY --from=frontend \
    --chown=www-data:www-data \
    /app/public/build /app/public/build

COPY --chown=www-data:www-data \
    Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Set semua env yang dibutuhkan Laravel agar bisa boot
ENV APP_NAME=MyPorto \
    APP_ENV=production \
    APP_KEY=base64:nlIg5aPSIFYC+Fv8dDh1qsXNtyZK+goLYYf/16TChrQ= \
    APP_DEBUG=true \
    APP_URL=https://my-porto-jade-ten.vercel.app \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]